---
import { DIAGNOSE_MAILTO, NAV_TABS } from '../lib/constants';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  return href === '/' ? path === '/' : path === href;
}

function tabClass(href: string) {
  const base =
    'text-[0.8125rem] tracking-wide transition-colors rounded-sm focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 focus:ring-offset-zinc-950';
  return isActive(href)
    ? `${base} text-white font-semibold border-b-2 border-white pb-0.5`
    : `${base} text-zinc-400 hover:text-white font-medium`;
}
---
<header id="main-nav" class="fixed top-0 left-0 right-0 z-40 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <nav class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3 lg:h-[4.25rem] lg:py-0" aria-label="Main navigation">
      <a href="/" class="font-semibold text-white tracking-tight shrink-0">
        <span class="xl:hidden text-[0.9375rem]">BMP</span>
        <span class="hidden xl:inline text-[0.9375rem]">BMP: Build. Manage. Perform.</span>
      </a>
      <div class="hidden lg:flex items-center gap-6">
        {NAV_TABS.map((tab, index) => (
          <>
            {index > 0 && (
              <span class="text-zinc-600" aria-hidden="true">|</span>
            )}
            <a href={tab.href} class={tabClass(tab.href)} aria-current={isActive(tab.href) ? 'page' : undefined}>
              {tab.label}
            </a>
          </>
        ))}
      </div>
      <a
        href={DIAGNOSE_MAILTO}
        class="inline-flex items-center justify-center rounded-md bg-foreground px-3 sm:px-4 py-2 text-[0.75rem] sm:text-[0.8125rem] font-semibold text-on-primary whitespace-nowrap transition-opacity hover:opacity-85 focus:outline-none focus:ring-2 focus:ring-foreground focus:ring-offset-2 focus:ring-offset-zinc-950"
      >
        Book a diagnose call
      </a>
      <div class="lg:hidden flex flex-wrap items-center gap-x-4 gap-y-2 pb-3 basis-full">
        {NAV_TABS.map((tab, index) => (
          <>
            {index > 0 && (
              <span class="text-zinc-600" aria-hidden="true">|</span>
            )}
            <a href={tab.href} class={tabClass(tab.href)} aria-current={isActive(tab.href) ? 'page' : undefined}>
              {tab.label}
            </a>
          </>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');

  function updateNavScroll() {
    if (!nav) return;
    if (window.scrollY > 16) {
      nav.classList.add('bg-zinc-950/90', 'backdrop-blur-sm', 'border-b', 'border-zinc-800/50');
    } else {
      nav.classList.remove('bg-zinc-950/90', 'backdrop-blur-sm', 'border-b', 'border-zinc-800/50');
    }
  }

  window.addEventListener('scroll', updateNavScroll);
  updateNavScroll();
</script>
