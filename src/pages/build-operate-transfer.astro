---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GradientDivider from '../components/GradientDivider.astro';
import ServicesTab from '../components/tabs/ServicesTab.astro';
import HowItWorksTab from '../components/tabs/HowItWorksTab.astro';
import AboutTab from '../components/tabs/AboutTab.astro';
import { PAGE_META } from '../lib/constants';
---
<BaseLayout title={PAGE_META.bot.title} description={PAGE_META.bot.description}>
  <Hero />
  <GradientDivider />
  <section class="max-w-6xl mx-auto px-6 lg:px-8 py-20 lg:py-28">
    <ServicesTab />
  </section>
  <GradientDivider />
  <section id="how-it-works" class="max-w-6xl mx-auto px-6 lg:px-8 py-20 lg:py-28 scroll-mt-40">
    <HowItWorksTab />
  </section>
  <GradientDivider />
  <section class="max-w-6xl mx-auto px-6 lg:px-8 py-20 lg:py-28">
    <AboutTab />
    <p class="mt-14 text-slate text-[0.9375rem] leading-relaxed">
      Need AI-native safety-critical delivery?{' '}
      <a href="/" class="text-foreground font-medium hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-foreground rounded-sm">→ AI-Native Delivery</a>
    </p>
  </section>
</BaseLayout>
